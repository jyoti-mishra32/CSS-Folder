<!DOCTYPE html>
<html>
<head>

  <title>CSS element selectors</title>  <!--The element selectors selects HTML elements based on the element name.-->
  
  <style>
    p {
      color: red;
      text-align: center;
    }
  </style>
</head>
<body>
  
  <p>Every paragraph will be affected by the style.</p>
  <p id="paral">Me too!</p>
  <p>And me!</p>
</body>
</html>
