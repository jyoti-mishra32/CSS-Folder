<!DOCTYPE html>
<html>
<head>

  <title>Rounded Borders</title>

  <style>
    p.normal {
      border: 2px solid red;
      padding: 5px;
    }

    p.round1 {
      border: 2px solid red;
      padding: 5px;
      border-radius: 5px;
    }

    p.round2 {
      border: 2px solid red;
      padding: 5px;
      border-radius: 8px;
    }

    p.round3 {
      border: 2px solid red;
      padding: 5px;
      border-radius: 12px;
    }
  </style>
</head>
<body>
  
  <p class="normal">Normal border</p>
  <p class="round1">Round border</p>
  <p class="round2">Rounder border</p>
  <p class="round3">Roundest border</p>
</body>
</html>
