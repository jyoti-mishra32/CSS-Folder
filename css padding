<!DOCTYPE html>
<html>
<head>

  <title>CSS Padding</title>   <!--Padding is the space inside an element, between the content and the border.-->

  <style>
    div {
      padding: 70px;
      border: 1px solid #4CAF50;
    }
  </style>
</head>
<body>

  <h2>CSS Padding</h2>
  <div>This element has a padding of 70px.
  </div>

</body>
</html>
