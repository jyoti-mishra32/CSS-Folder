<!DOCTYPE html>
<html>
<head>

  <title>CSS Outline Color</title> <!--The outline-color property is used to set the color of the outline.-->

  <style>
    p {
      padding: 10px;
      border: 1px solid black;
    }

    p.ex1 {
      outline-style: solid;
      outline-color: red;
    }

    p.ex2 {
      outline-style: dotted;
      outline-color: blue;
    }

    p.ex3 {
      outline-style: outset;
      outline-color: green;
    }

    p.ex4 {
      outline-style: solid;
      outline-color: invert;
    }
  </style>
</head>
<body>
  
  <h2>The outline-color Property</h2>

  <p class="ex1">A solid red outline.</p>
  <p class="ex2">A dotted blue outline.</p>
  <p class="ex3">A outset green outline.</p>
  <p class="ex4">A solid invert outline.</p>


</body>
</html>
