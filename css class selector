<!DOCTYPE html>
<html>
<head>

  <title>CSS Class Selector</title>  <!--The class selector selects HTML elements with a specific class attribute.-->
  
  <style>
    .center {
      color: green;
      text-align: center;
    }
  </style>
</head>
<body>
  
  <h1 class="center">Red and center-aligned heading</h1>
  <p class="center">Red and center-aligned paragraph.</p>
</body>
</html>
