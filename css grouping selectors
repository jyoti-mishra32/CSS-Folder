<!DOCTYPE html>
<html>
<head>
  
  <title>Grouping Selectors</title>  <!--The grouping selectors selects all the HTML elements with the same style definitions.-->

  <style>
    h1, h2, p {
      color: red;
      text-align: center;
    }
  </style>
</head>
<body>
  
  <h1>Hello World!</h1>
  <h2>Smaller heading!</h2>
  <p>This is a paragraph.</p>

</body>
</html>
