<!DOCTYPE html>
<html>
<head>

  <title>Universal Selector</title>  <!--The universal selector (*) selects all HTML elements on the page-->
  
  <style>
    * {
      color: blue;
      text-align: center;
    }
  </style>
</head>
<body>
  
<h1>Hello World</h1>
<p>Every element on the page will be affected by the style./p>
<p id="para1">Me too!</p>
<p>And me!</p>
</body>
</html>
